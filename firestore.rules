rules_version = '2';

// Bible Games Daily: each signed-in player can read and write only their own progress document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ageConfirmed', 'createdAt', 'updatedAt', 'data', 'times'])
        && request.resource.data.ageConfirmed == true
        && request.resource.data.data is map
        && request.resource.data.times is map;
    }

    // Build-a-Figure live battles. Anyone signed in (players can be anonymous guests) can open a room by its code,
    // but rooms can't be listed. The host creates the room; one other player can join it, once.
    match /battles/{room} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && room.size() >= 8 && room.size() <= 16
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'guest', 'guestName', 'createdAt', 'settings'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 24
        && request.resource.data.settings is map;

      allow update: if request.auth != null
        && resource.data.guest == null
        && request.auth.uid != resource.data.host
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName'])
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 24;

      // Each player's side of the battle: only the two players can read it, and each writes only their own.
      match /players/{uid} {
        function roomData() { return get(/databases/$(database)/documents/battles/$(room)).data; }
        function inRoom() {
          return request.auth != null
            && (request.auth.uid == roomData().host || request.auth.uid == roomData().guest);
        }
        allow read: if inRoom();
        allow create, update: if inRoom()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'progress', 'ready', 'stats', 'figs', 'commits', 'reveals', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.commits is list && request.resource.data.commits.size() <= 7
          && request.resource.data.reveals is list && request.resource.data.reveals.size() <= 7;
      }
    }

    // Build-a-Figure challenge links: lets the result reach the player who sent the challenge.
    // Anyone signed in can open a challenge by its code (it's in the link); the result can be written once,
    // by someone other than the sender.
    match /challenges/{id} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && id.size() >= 8 && id.size() <= 16
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'createdAt', 'result'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 24
        && request.resource.data.result == null;

      allow update: if request.auth != null
        && resource.data.result == null
        && request.auth.uid != resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result', 'responderName', 'resultAt'])
        && request.resource.data.result is string && request.resource.data.result.size() <= 6000
        && request.resource.data.responderName is string && request.resource.data.responderName.size() <= 24;
    }

    // Nothing else in the database can be read or written from the site.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
